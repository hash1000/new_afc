# Resend API key. Keep this server-side and never prefix it with NEXT_PUBLIC_.
RESEND_API_KEY=re_xxxxxxxxx

# A sender address or domain verified in Resend.
RESEND_FROM_EMAIL=Americas Food Court <no-reply@americasfoodcourt.com>
# Nest API (public URL, never put secrets in NEXT_PUBLIC variables)
NEXT_PUBLIC_API_URL=http://localhost:8500/api
